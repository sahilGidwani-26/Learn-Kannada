{
  "expo": {
    "name": "Kannada Buddy",
    "slug": "kannada-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FF6B35",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kannadabuddy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kannada Buddy needs camera access to scan Kannada text.",
        "NSMicrophoneUsageDescription": "Kannada Buddy needs microphone access for voice features."
      }
    },
    "android": {
      "package": "com.kannadabuddy.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Kannada Buddy needs camera access to scan Kannada text."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "29a58d2c-e9b6-4717-a06e-209cc8bff39b"
      }
    }
  }
}
